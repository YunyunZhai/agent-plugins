{
  "name": "agent-plugins",
  "owner": {
    "name": "YunyunZhai"
  },
  "metadata": {
    "description": "Claude Code 插件工具集：插件推荐与市场发现",
    "version": "1.0.0"
  },
  "plugins": [
    {
      "name": "plugin-recommender",
      "source": "./plugins/plugin-recommender",
      "description": "从已安装的插件市场中根据自然语言查询推荐最合适的 Claude Code 插件。使用 Pinecone 向量搜索粗筛，再由 AI 精选推荐。",
      "version": "1.0.0",
      "author": {
        "name": "YunyunZhai"
      },
      "category": "productivity",
      "tags": ["plugins", "recommender", "pinecone", "discovery"],
      "homepage": "https://github.com/YunyunZhai/agent-plugins",
      "repository": "https://github.com/YunyunZhai/agent-plugins",
      "license": "MIT"
    },
    {
      "name": "usage-stats",
      "source": "./plugins/usage-stats",
      "description": "本地用量统计状态栏：显示 tp5m/tp5h/rp5m/rp5h/今日累计 token 用量与请求数，通过 hook 逐回合记录，数据存于 ~/.claude/usage-logs/。",
      "version": "1.0.0",
      "author": {
        "name": "YunyunZhai"
      },
      "category": "productivity",
      "tags": ["usage", "tokens", "cost", "statusline", "rate-limit", "monitoring"],
      "homepage": "https://github.com/YunyunZhai/agent-plugins",
      "repository": "https://github.com/YunyunZhai/agent-plugins",
      "license": "MIT"
    },
    {
      "name": "gh-search",
      "source": "./plugins/gh-search",
      "description": "GitHub 智能开源项目搜索：根据语义意图通过 4 步过滤管线（GraphQL 召回 → 元数据粗筛 → 成熟度指标过滤 → 可选 README 深度增强）召回并精选高赞开源项目，由大模型打分推荐。",
      "version": "1.0.0",
      "author": {
        "name": "YunyunZhai"
      },
      "category": "productivity",
      "tags": ["github", "search", "opensource", "recommender", "discovery", "graphql"],
      "homepage": "https://github.com/YunyunZhai/agent-plugins",
      "repository": "https://github.com/YunyunZhai/agent-plugins",
      "license": "MIT"
    }
  ]
}
